    {
      "type": "timeseries",
      "title": "SQS dispatch backlog",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A",
          "namespace": "AWS/SQS",
          "metricName": "ApproximateNumberOfMessagesVisible",
          "dimensions": {
            "QueueName": [
              "dispatchx-dispatch"
            ]
          },
          "statistic": "Maximum",
          "period": "60",
          "region": "default",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "label": "backlog"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "B",
          "namespace": "AWS/SQS",
          "metricName": "ApproximateNumberOfMessagesVisible",
          "dimensions": {
            "QueueName": [
              "dispatchx-dispatch-dlq"
            ]
          },
          "statistic": "Maximum",
          "period": "60",
          "region": "default",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "label": "DLQ"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
